{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "src/*": ["./src/*"]
    },
    "rootDir": ".",
    "outDir": "./dist/out-tsc",
    "target": "ES2022",
    "typeRoots": ["node_modules/@types"],
    "strict": true,
    "sourceMap": true,
    "declaration": false,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "importHelpers": true,
    "experimentalDecorators": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  }
}
